# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置
# DB_TYPE: sqlite | mysql | postgres
DB_TYPE=sqlite

# SQLite (only used when DB_TYPE=sqlite)
DB_PATH=./data/marketplace.db

# MySQL / PostgreSQL (only used when DB_TYPE=mysql or postgres)
DB_HOST=127.0.0.1
DB_PORT=3306        # MySQL: 3306, PostgreSQL: 5432
DB_NAME=clawbench
DB_USER=root
DB_PASSWORD=

# JWT 配置
# 生产环境必须改为 >= 16 字符的强随机值，否则服务会拒绝启动
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS 白名单（逗号分隔；不设置时允许所有来源，生产环境必须设置）
# 非生产环境会额外放行 localhost / 127.0.0.1 任意端口（Vite / electron-vite dev）
# 客户端 dev 访问远程 API 时，也可依赖前端 Vite `/api` 代理，无需改服务端 CORS
# CORS_ORIGIN=https://your-app.example.com,https://admin.example.com

# 反向代理（Express trust proxy）。默认不信任代理；部署在 Nginx/Caddy 等反代之后时
# 设为代理跳数（通常 1），否则限流会把所有请求算到代理 IP 上。
# 也可填 true / loopback / 子网列表（原样传给 Express）
# TRUST_PROXY=1

# 限流阈值（按客户端 IP 计数；NODE_ENV=test 时不启用）
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_PER_15MIN=20               # 登录 / 注册
# RATE_LIMIT_RELEASE_DOWNLOAD_PER_HOUR=50    # 安装包下载（latest*.yml / .blockmap 不计入）
# RATE_LIMIT_APP_DOWNLOAD_PER_HOUR=100       # 市场应用下载
# RATE_LIMIT_UPLOAD_PER_HOUR=30              # 应用包 / 通用应用归档 / 安装包上传
# RATE_LIMIT_AI_STREAM_PER_15MIN=100         # AI 流式对话 / 标题生成
# RATE_LIMIT_CREATE_APP_PER_HOUR=10          # 创建应用（POST /api/v1/applications）

# 文件存储配置
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# AI 配置（服务端内置模型，供 AI 助手内置模型列表使用）
# 格式：JSON 数组字符串；每个对象包含 id/name/provider/endpoint/apiKey，可选 maxTokens/apiVersion
# provider 示例：openai | azure-openai | claude | google
AI_BUILTIN_MODELS='[{"id":"gpt-4o-mini","name":"GPT-4o Mini","provider":"openai","endpoint":"https://api.openai.com/v1","apiKey":"your-openai-api-key","maxTokens":4096}]'

# 飞书 OAuth 配置
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_REDIRECT_URI=http://localhost:3001/api/v1/auth/feishu/callback
